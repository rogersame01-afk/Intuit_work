-- with radio buttons;
-- https://docs.google.com/document/d/15xQqVNVjiF8YyeEpTEvas1whtLqNoNQqd5MZfQnlZII/edit?tab=t.0

create table awsdatacatalog.cgan_ustax_ws.aw_4224_radio_selections as (
    with radio as (
        select c.pseudonym_id
            , c.screen
            , c.ui_object_detail
            , max(c.date_time) as max_select_event_date_time
        from tax_src.fact_clickstream_psd c
        where c.tax_year = '2024'
            and c.screen = 'efverify-agi-returnAccess'
            and c.ui_object_detail like 'return-access%'
            and c.ui_object_detail in(
                'return-access-can-get-it-now'
                , 'return-access-transcript'
                , 'return-access-prev-year-return-not-processed'
                , 'return-access-cannot-get-it-now'
                , 'return-access-didnt-file-last-year'
                , 'return-access-didnt-file-but-stimulus-last-year'
                , 'return-access-can-get-it-now-v2.0'
                , 'return-access-transcript-v2.0'
                , 'return-access-prev-year-return-not-processed'
                , 'return-access-cannot-get-it-now'
                , 'return-access-didnt-file-last-year-v2.0'
            )
            and date(c.date_time) between date('2024-12-20') and date('2025-01-25') -- dates when both recipes were getting traffic;
        group by 1,2,3
    ),
    
    radio_sorted as (
        select r.pseudonym_id
            , r.ui_object_detail
            , r.max_select_event_date_time
            , row_number() over(partition by r.pseudonym_id order by r.max_select_event_date_time desc) as rnum -- get their last selection
        from radio r
    ),
    
    base as (
        select *
        from radio_sorted rs
        where rs.rnum = 1
    )
    
    select b.pseudonym_id
        , max(if(b.ui_object_detail = 'return-access-can-get-it-now',1,0)) as a_can_get_it_now
        , max(if(b.ui_object_detail = 'return-access-transcript',1,0)) as b_transcript
        , max(if(b.ui_object_detail = 'return-access-prev-year-return-not-processed',1,0)) as c_prev_return_not_processed
        , max(if(b.ui_object_detail = 'return-access-cannot-get-it-now',1,0)) as d_cannot_get_it_now
        , max(if(b.ui_object_detail = 'return-access-didnt-file-last-year',1,0)) as e_didnt_file_last_year
        , max(if(b.ui_object_detail = 'return-access-didnt-file-but-stimulus-last-year',1,0)) as f_didnt_file_but_stimulus_last_year
        
        , max(if(b.ui_object_detail = 'return-access-can-get-it-now-v2.0',1,0)) as av2_can_get_it_now
        , max(if(b.ui_object_detail = 'return-access-transcript-v2.0',1,0)) as bv2_transcript
        , max(if(b.ui_object_detail = 'return-access-prev-year-return-not-processed',1,0)) as cv2_prev_return_not_processed
        , max(if(b.ui_object_detail = 'return-access-cannot-get-it-now',1,0)) as dv2_cannot_get_it_now
        , max(if(b.ui_object_detail = 'return-access-didnt-file-last-year-v2.0',1,0)) as ev2_didnt_file_last_year
    from base b
    group by 1
)
;

