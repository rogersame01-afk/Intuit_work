SELECT tp.auth_id
    , tp.tax_year
     
    -- Form 1099-INT is issued by all entities that pay interest income to investors at the end of the year.
    , MAX(CASE WHEN xpath LIKE '%1095%' THEN element_text ELSE '0' END) 1095A_part_of_return
  
FROM tax_src.cg_filing_taxml_payload tp
WHERE 1=1
    AND (xpath_partition = 'TaxReturns__USIndividualTaxReturn__US1040PER__F1095')
    AND element_name in ('__POR__')
    AND tp.tax_year = 2024
    AND tp.type = 'tt'
 
GROUP BY 1,2
limit 100



with rej as (
    select distinct re.tax_year
        , re.auth_id
    from dlprd.tax_dm.fact_efile_reject_error re
    left join dlprd.tax_dm.dim_efile_reject_code rc
        on re.efile_reject_code_id = rc.efile_reject_code_id
    where re.filing_type_id = '244'
        and re.tax_year in(2023,2024)
        and re.auth_id <> -1
        and rc.error_code = 'F8962-070'
        and (case when re.tax_year = 2023 then date(re.efile_status_timestamp) <= date('2024-01-24') end)
),

form as (
    SELECT tp.auth_id
        , tp.tax_year
         
        -- Form 1099-INT is issued by all entities that pay interest income to investors at the end of the year.
        , MAX(CASE WHEN xpath LIKE '%1095%' THEN element_text ELSE '0' END) has_1095A_part_of_return
      
    FROM tax_src.cg_filing_taxml_payload tp
    WHERE 1=1
        AND (xpath_partition = 'TaxReturns__USIndividualTaxReturn__US1040PER__F1095')
        AND element_name in ('__POR__')
        AND tp.tax_year in(2023,2024)
        and (case when tp.tax_year = 2023 then date(tp.received_date) <= date('2024-01-24') end)
        AND tp.type = 'tt'
     
    GROUP BY 1,2
)

select f.tax_year
    , f.has_1095A_part_of_return
    , case when rej.auth_id is not null then 1 else 0 end as rejected_flag
    , count(distinct f.auth_id) as customers
from form f
left join rej


    SELECT tp.auth_id
        , tp.tax_year
         
        -- Form 1099-INT is issued by all entities that pay interest income to investors at the end of the year.
        , MAX(CASE WHEN xpath LIKE '%1095%' THEN element_text ELSE '0' END) has_1095A_part_of_return
      
    FROM tax_src.cg_filing_taxml_payload tp
    WHERE 1=1
        AND (xpath_partition = 'TaxReturns__USIndividualTaxReturn__US1040PER__F1095')
        AND element_name in ('__POR__')
        AND tp.tax_year in(2023,2024)
        and (case when tp.tax_year = 2023 then date(tp.received_date) <= date('2024-01-24') end)
        AND tp.type = 'tt'
     
    GROUP BY 1,2
    on f.auth_id = rej.auth_id
        and f.tax_year = rej.tax_year
group by 1,2,3
order by 1,2,3
;


