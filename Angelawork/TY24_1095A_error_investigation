        , tp.tax_year
        , MAX(CASE WHEN xpath LIKE '%1095%' THEN element_text ELSE '0' END) has_1095A_part_of_return
    FROM tax_src.cg_filing_taxml_payload tp
    WHERE 1=1
        AND (xpath_partition = 'TaxReturns__USIndividualTaxReturn__US1040PER__F1095')
        AND element_name in ('__POR__')
        AND tp.tax_year in(2023)
        and (case when tp.tax_year = 2023 then date(tp.received_date) <= date('2024-01-24') end)
        AND tp.type = 'tt'
    GROUP BY 1,2
),

rejected_ty23 as (
    select distinct re.tax_year
        , re.auth_id
    from dlprd.tax_dm.fact_efile_reject_error re
    left join dlprd.tax_dm.dim_efile_reject_code rc
        on re.efile_reject_code_id = rc.efile_reject_code_id
    where re.filing_type_id = '244'
        and re.tax_year in(2023)
        and re.auth_id <> -1
        and rc.error_code = 'F8962-070'
        and (case when re.tax_year = 2023 then date(re.efile_status_timestamp) <= date('2024-01-24') end)
)

select case when b.auth_id is not null then 1 else 0 end as had_form_last_year
    , case when c.auth_id is not null then 1 else 0 end as rejected
    , count(distinct a.auth_id) as users
from had_form_ty23 a
left join had_form_ty22 b
    on a.auth_id = b.auth_id
        and b.has_1095A_part_of_return = '1'
left join rejected_ty23 c
    on a.auth_id = c.auth_id
where a.has_1095A_part_of_return = '1'
group by 1,2
order by 1,2
;


