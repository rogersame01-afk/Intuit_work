-- actual list delivery;
select * from dlprd.cgan_ustax_ws.ty23_outbound_call_list_to_dials ob limit 100;


select case when (lower(ob.outreach) like '%reject%' and lower(ob.outreach) like '%state%') then 'State'
           when lower(ob.outreach) like '%reject%' then 'Fed'
      end as outreach_rollup
    -- , cast(cast(ob.dt as timestamp) as date) as list_date
    , ob.dt
    , sum(ob.distinct_customers_in_call_list) list_size
from dlprd.cgan_ustax_ws.ty23_outbound_call_list_to_dials ob
where lower(ob.outreach) like '%reject%'
group by 1,2
order by 1,2
;

select case when (lower(ob.outreach) like '%reject%' and lower(ob.outreach) like '%state%') then 'State'
           when lower(ob.outreach) like '%reject%' then 'Fed'
      end as outreach_rollup
    -- , cast(cast(ob.dt as timestamp) as date) as list_date
    , min(ob.dt)
    , sum(ob.distinct_customers_in_call_list) list_size
from dlprd.cgan_ustax_ws.ty23_outbound_call_list_to_dials ob
where lower(ob.outreach) like '%reject%'
group by 1
order by 1
;
