create table awsdatacatalog.cgan_ustax_ws.aw_1095a_flow_part5ty23 as (
-- how did they answer gateway;
with gateway_answer as (

select * from awsdatacatalog.cgan_ustax_ws.aw_1095a_flow_gateway_answer_ty23

union

select * from awsdatacatalog.cgan_ustax_ws.aw_1095a_flow_gateway_answer_ty23_part2

