-- counts with suppression;			
with segments as (					
select * from cgan_ustax_ws.aw_a_					
union					
select * from cgan_ustax_ws.aw_b_					
union					
select * from cgan_ustax_ws.aw_c_					
),					
					
risk as (					
select distinct a.auth_id					
from (					
select cast(m.person as bigint) as auth_id					
, m.atrisk_probability					
, m.atrisk_flag					
, m.tax_year					
, m.timestamp					
, row_number() over(partition by m.person, m.tax_year order by m.timestamp desc) as rnum					
from dlprd.feature_store.data_datalake_atrisk_model m					
) a					
where a.rnum = 1 -- pull the most recent record for that auth_id and year;					
and a.atrisk_flag = 1					
and a.tax_year = 2022					
)					

select distinct pam2.pseudonym_id
from (
    select case when risk.auth_id is not null then 1 else 0 end as atrisk_flag					
    , case when pam.auth_id is null then '1. No Auth'					
           when pam.auth_id is not null and pam.first_start_date is null then '2. Auth Not Start'					
           when pam.first_start_date is not null and pam.first_completed_date is null then '3. Start Not Complete'					
      else '4. Complete'					
      end as funnel					
    , case when be.auth_id is not null then 1 else 0 end as be_flag					
    , s.auth_id	
    from segments s					
        inner join dlprd.tax_dm.v_dim_marketing_taxcust_profile_list cv					
            on s.auth_id = cv.auth_id					
            and cv.auth_id is not null					
            and cv.addr_line_1 is not null -- include only those with addresses;					
            and cv.mark_cust_iden <> -1					
    left join cgan_ustax_ws.aw_email_opt_outs eoo					
        on cv.lower_email = eoo.lower_email					
    left join cgan_ustax_ws.aw_dm_opt_outs dmoo					
        on cv.mark_cust_iden = dmoo.mark_cust_iden					
    left join risk					
        on s.auth_id = risk.auth_id					
    left join dlprd.tax_rpt.product_analytics_master pam					
        on s.auth_id = pam.auth_id					
        and pam.tax_year = 2022					
    left join dlprd.cgan_ustax_published.ty22_jan_dm_list dm					
        on s.auth_id = cast(dm.auth_id as bigint)					
    left join (					
    -- predicted to defect due to a bad experience in TY21;					
    select distinct a.auth_id					
    from (					
        select cast(m.person as bigint) as auth_id					
        , m.be_atrisk_probability					
        , m.be_atrisk_flag					
        , m.tax_year					
        , m.timestamp					
        , row_number() over(partition by m.person, m.tax_year order by m.timestamp desc) as rnum					
        from dlprd.feature_store.datapersist_datalake_be_atrisk_model_scores m					
    ) a					
    where a.rnum = 1 -- pull the most recent record for that auth_id and year;					
        and a.be_atrisk_flag = 1					
        and a.tax_year = 2022					
    ) be					
    on s.auth_id = be.auth_id					
    where eoo.lower_email is null -- suppress email opt outs;					
        and dmoo.mark_cust_iden is null -- suppress dm opt outs;					
        and dm.auth_id is null		
        and pam.first_neauth_date is null
) list
left join dlprd.tax_rpt.product_analytics_master pam2
    on list.auth_id = pam2.auth_id
        and pam2.tax_year = 2021 -- in order to get pseudonym_id
where list.funnel = '1. No Auth'
;
